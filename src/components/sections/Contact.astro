---
import type { ui } from '@/i18n/ui';

interface Props {
  t: typeof ui.es.contact;
}

const { t } = Astro.props;
const mailto = `mailto:${t.email}`;
---

<section id="contact" class="contact grain" data-track-section="contact">
  <div class="ambient contact-glow" aria-hidden="true"></div>
  <div class="contact-rings" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <div class="page contact-inner">
    <img src="/svg/brand/cube-pack.svg" alt="" width="240" height="260" class="contact-cube reveal" loading="lazy" />

    <p class="eyebrow" data-scramble>{t.eyebrow}</p>
    <h2 class="contact-title" data-split>{t.heading}</h2>
    <p class="contact-body reveal">{t.body}</p>

    <a href={mailto} class="contact-cta mono reveal" data-magnetic data-track-cta="contact-send">
      <span>{t.email}</span>
      <span class="contact-cta-icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M2 7 H12 M12 7 L7.5 2.5 M12 7 L7.5 11.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>

    <p class="mono contact-foot reveal">{t.location}<span aria-hidden="true"> · </span>{t.footnote}</p>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding: clamp(96px, 14vh, 160px) 0;
    background: #08090b;
    border-top: 1px solid rgba(248, 243, 235, 0.08);
  }
  .contact-glow {
    left: 50%;
    top: 36%;
    width: 820px;
    height: 600px;
    margin: -300px 0 0 -410px;
    background: radial-gradient(closest-side, rgba(254, 93, 28, 0.14), rgba(254, 93, 28, 0));
  }
  .contact-rings {
    position: absolute;
    left: 50%;
    top: 30%;
    pointer-events: none;
  }
  .contact-rings span {
    position: absolute;
    left: 0;
    top: 0;
    width: 280px;
    height: 280px;
    margin: -140px 0 0 -140px;
    border-radius: 50%;
    border: 1px solid rgba(254, 93, 28, 0.25);
    animation: ring 6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    opacity: 0;
  }
  .contact-rings span:nth-child(2) { animation-delay: 2s; }
  .contact-rings span:nth-child(3) { animation-delay: 4s; }
  @keyframes ring {
    0% { transform: scale(0.5); opacity: 0.7; }
    100% { transform: scale(3.2); opacity: 0; }
  }

  .contact-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .contact-cube {
    width: clamp(150px, 16vw, 200px);
    height: auto;
    margin-bottom: 20px;
  }
  .contact-title {
    margin: 18px 0 0;
    font-weight: 700;
    font-size: clamp(44px, 6.4vw, 88px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #f8f3eb;
  }
  .contact-body {
    margin: 22px 0 0;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(248, 243, 235, 0.55);
  }

  .contact-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    padding: 12px 12px 12px 28px;
    border-radius: 999px;
    border: 1px solid rgba(248, 243, 235, 0.18);
    background: rgba(255, 255, 255, 0.03);
    color: #f8f3eb;
    font-size: clamp(15px, 1.4vw, 18px);
    text-decoration: none;
    transition: border-color 200ms ease, background 200ms ease, transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
    transform: translate(var(--mx, 0px), var(--my, 0px));
  }
  .contact-cta:hover {
    border-color: rgba(254, 93, 28, 0.55);
    background: rgba(254, 93, 28, 0.07);
  }
  .contact-cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fe5d1c;
    color: #0a0b0e;
    transition: transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .contact-cta:hover .contact-cta-icon {
    transform: rotate(-45deg);
  }
  .contact-foot {
    margin: 28px 0 0;
    font-size: 12.5px;
    color: rgba(248, 243, 235, 0.38);
  }

  @media (max-width: 520px) {
    .contact-cta { padding-left: 20px; gap: 10px; font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-rings span { animation: none; }
  }
</style>
