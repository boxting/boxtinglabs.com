---
import type { ui } from '@/i18n/ui';

interface Props {
  t: typeof ui.es.capabilities;
}

const { t } = Astro.props;
---

<section
  id="capabilities"
  class="relative bg-cream text-ink py-10 overflow-hidden"
  data-track-section="capabilities"
>
  <div aria-hidden="true" class="iso-pattern pointer-events-none absolute inset-0 opacity-40"></div>

  <div class="page relative" data-stagger="100">
    <div class="grid grid-cols-12 gap-y-6 md:gap-x-6 items-end">
      <div class="col-span-12 md:col-span-7">
        <p class="eyebrow reveal">{t.eyebrow}</p>
        <h2
          class="reveal mt-4 text-ink"
          style="font-size: clamp(36px, 5vw, 56px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 700;"
        >
          {t.heading}
        </h2>
      </div>
      <div class="col-span-12 md:col-span-5">
        <p class="reveal text-body text-steel max-w-prose">
          {t.lede}
        </p>
      </div>
    </div>

    <ul class="mt-9 grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6" data-stagger="120">
      {t.items.map((item) => (
        <li class="reveal">
          <div
            class="glass group h-full p-6 md:p-7 transition-all duration-base ease-brand hover:-translate-y-0.5"
            style="border-radius: 18px;"
          >
            <div class="flex items-start gap-5">
              <span
                class="mono text-caption text-orange pt-1 transition-transform duration-base ease-brand group-hover:-translate-y-0.5"
                style="min-width: 28px;"
              >{item.n}</span>
              <div class="flex-1">
                <h3 class="text-h3 text-ink font-semibold transition-colors duration-base ease-brand group-hover:text-orange">{item.title}</h3>
                <p class="mt-2 text-body text-steel">{item.body}</p>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
