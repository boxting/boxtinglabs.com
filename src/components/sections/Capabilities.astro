---
import type { ui } from '@/i18n/ui';
import SpotlightCard from '@/components/motion/SpotlightCard';

interface Props {
  t: typeof ui.es.capabilities;
}

const { t } = Astro.props;
const icons = ['software', 'ai', 'cloud', 'consulting'];
const accents = ['254,93,28', '254,93,28', '125,163,255', '124,214,180'];
---

<section id="capabilities" class="capabilities" data-track-section="capabilities">
  <div class="ambient cap-glow" aria-hidden="true"></div>

  <div class="page relative">
    <div class="grid grid-cols-12 items-end gap-y-5 md:gap-x-6">
      <div class="col-span-12 md:col-span-7">
        <p class="eyebrow" data-scramble>{t.eyebrow}</p>
        <h2 class="section-title mt-4" data-split>{t.heading}</h2>
      </div>
      <p class="cap-lede col-span-12 md:col-span-5 reveal">{t.lede}</p>
    </div>

    <ul class="cap-grid" data-rise="100">
      {t.items.map((item, i) => (
        <li>
          <SpotlightCard client:visible rgb={accents[i]} tilt={4}>
            <article class="cap-card">
              <div class="cap-top">
                <img src={`/svg/practice/${icons[i]}.svg`} alt="" width="72" height="72" class="cap-icon" loading="lazy" />
                <span class="mono cap-n">{item.n}</span>
              </div>
              <h3 class="cap-title">{item.title}</h3>
              <p class="cap-body">{item.body}</p>
            </article>
          </SpotlightCard>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .capabilities {
    position: relative;
    overflow: hidden;
    padding: clamp(96px, 14vh, 160px) 0;
    background: #08090b;
  }
  .cap-glow {
    right: -200px;
    top: -140px;
    width: 640px;
    height: 600px;
    background: radial-gradient(closest-side, rgba(43, 92, 230, 0.12), rgba(43, 92, 230, 0));
  }
  .cap-lede {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(248, 243, 235, 0.52);
    max-width: 46ch;
  }

  .cap-grid {
    list-style: none;
    margin: clamp(48px, 7vh, 72px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .cap-card {
    padding: clamp(24px, 2.6vw, 36px);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cap-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  .cap-icon {
    width: 72px;
    height: 72px;
    margin: -6px 0 0 -6px;
  }
  .cap-n {
    font-size: 13px;
    color: #fe5d1c;
  }
  .cap-title {
    margin: 0;
    font-weight: 600;
    font-size: clamp(20px, 1.7vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #f8f3eb;
  }
  .cap-body {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(248, 243, 235, 0.52);
    max-width: 52ch;
  }

  @media (max-width: 760px) {
    .cap-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
