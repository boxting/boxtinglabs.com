---
import type { ui } from '@/i18n/ui';
import PracticeScroll from '@/components/motion/PracticeScroll';

interface Props {
  t: typeof ui.es.capabilities;
}

const { t } = Astro.props;
---

<section id="capabilities" class="capabilities" data-track-section="capabilities">
  <div class="ambient cap-glow" aria-hidden="true"></div>

  <div class="page relative">
    <PracticeScroll client:visible items={t.items}>
      <div slot="intro">
        <p class="eyebrow" data-scramble>{t.eyebrow}</p>
        <h2 class="section-title mt-4" data-split>{t.heading}</h2>
        <p class="cap-lede reveal">{t.lede}</p>
      </div>
    </PracticeScroll>
  </div>
</section>

<style>
  .capabilities {
    position: relative;
    /* clip, not hidden: hidden would make this a scroll container and break the sticky stage */
    overflow: clip;
    padding: clamp(96px, 14vh, 160px) 0;
    background: #08090b;
  }
  .cap-glow {
    right: -200px;
    top: -140px;
    width: 640px;
    height: 600px;
    background: radial-gradient(closest-side, rgba(43, 92, 230, 0.12), rgba(43, 92, 230, 0));
  }
  .cap-lede {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(248, 243, 235, 0.52);
    max-width: 46ch;
  }
</style>
