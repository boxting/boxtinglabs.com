---
import type { ui } from '@/i18n/ui';

interface Props {
  lang: 'en' | 'es';
  t: typeof ui.es.nav;
}

const { lang, t } = Astro.props;
const otherLangHref = lang === 'es' ? '/en/' : '/';
const otherLangLabel = lang === 'es' ? 'EN' : 'ES';
const otherLangAria = lang === 'es' ? 'Switch to English' : 'Cambiar a Español';
const homeHref = lang === 'es' ? '/' : '/en/';
---

<header id="site-nav" class="site-nav" data-site-nav>
  <div class="nav-inner">
    <a href={homeHref} class="nav-brand" aria-label="Boxting Labs" data-track-cta="nav-home">
      <svg class="nav-cube" viewBox="0 0 144 159" aria-hidden="true">
        <path class="nav-cube-body" d="M67 .06C72.5-.24 77.8.6 83 2.56C98 10.89 113 19.22 128 27.56C135.7 31.6 140.9 37.77 143.5 46.06C144.2 68.06 144.2 90.06 143.5 112.06C141.3 119.63 136.8 125.46 130 129.56C113.1 139.16 96.1 148.49 79 157.56C72.4 158.64 66.1 157.97 60 155.56C43.5 146.48 27.2 137.14 11 127.56C5.4 122.97 1.9 117.13.5 110.06C-.17 89.06-.17 68.06.5 47.06C3.8 38.09 9.6 31.25 18 26.56C34.1 17.16 50.5 8.32 67 .06Z" fill="#FE5D1C"></path>
        <path class="nav-cube-top" d="M66 26.06C70 25.89 74 26.06 78 26.56C89.7 32.72 101 39.39 112 46.56C100.1 54.02 87.7 60.68 75 66.56C72.7 67.22 70.3 67.22 68 66.56C55.8 59.98 43.8 53.14 32 46.06C43.4 39.36 54.7 32.7 66 26.06Z" fill="#F8F3EB"></path>
        <path d="M22 66.06C32.3 71.88 42.6 77.71 53 83.56C56.2 85.39 58.7 87.89 60.5 91.06C62.1 104.32 62.4 117.66 61.5 131.06C51.2 124.84 40.7 119.01 30 113.56C27.3 111.96 25.1 109.8 23.5 107.06C22.1 93.46 21.6 79.8 22 66.06Z" fill="#F8F3EB"></path>
      </svg>
      <span class="nav-word">boxting <span>labs</span></span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href="#studio" data-track-cta="nav-manifesto">{t.manifesto}</a>
      <a href="#capabilities" data-track-cta="nav-capabilities">{t.capabilities}</a>
      <a href="#work" data-track-cta="nav-work">{t.work}</a>
    </nav>

    <div class="nav-actions">
      <a href={otherLangHref} class="nav-lang mono" aria-label={otherLangAria} data-track-cta="language-switch">
        {otherLangLabel}
      </a>
      <a href="#contact" class="nav-cta" data-track-cta="nav-contact">
        {t.contact}
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7 H12 M12 7 L7.5 2.5 M12 7 L7.5 11.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1), background 300ms ease, border-color 300ms ease;
    border-bottom: 1px solid transparent;
    animation: nav-in 700ms 200ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes nav-in {
    from { opacity: 0; transform: translateY(-14px); }
    to { opacity: 1; transform: none; }
  }
  .site-nav.is-scrolled {
    background: rgba(8, 9, 11, 0.72);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border-bottom-color: rgba(248, 243, 235, 0.08);
  }
  .site-nav.is-hidden {
    transform: translateY(-100%);
  }

  .nav-inner {
    max-width: 1440px;
    margin: 0 auto;
    height: 68px;
    padding: 0 clamp(16px, 4vw, 56px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #f8f3eb;
    justify-self: start;
  }
  .nav-cube {
    width: 24px;
    height: 26px;
    overflow: visible;
  }
  .nav-cube-top {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .nav-brand:hover .nav-cube-top {
    transform: translateY(-9px);
  }
  .nav-word {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.02em;
  }
  .nav-word span {
    color: #fe5d1c;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-links a {
    position: relative;
    padding: 10px 14px;
    font-size: 14px;
    color: rgba(248, 243, 235, 0.68);
    text-decoration: none;
    border-radius: 999px;
    transition: color 160ms ease, background 160ms ease;
  }
  .nav-links a:hover {
    color: #f8f3eb;
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-actions {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .nav-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 40px;
    padding: 0 10px;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: rgba(248, 243, 235, 0.55);
    text-decoration: none;
    border-radius: 999px;
    transition: color 160ms ease, background 160ms ease;
  }
  .nav-lang:hover {
    color: #f8f3eb;
    background: rgba(255, 255, 255, 0.05);
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 18px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(248, 243, 235, 0.16);
    color: #f8f3eb;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    border-radius: 999px;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }
  .nav-cta:hover {
    background: #fe5d1c;
    border-color: #fe5d1c;
    color: #0a0b0e;
  }

  @media (max-width: 860px) {
    .nav-inner { grid-template-columns: 1fr auto; }
    .nav-links { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav { animation: none; }
  }
</style>

<script>
  function bindNav() {
    const nav = document.querySelector<HTMLElement>('[data-site-nav]');
    if (!nav) return;
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      nav.classList.toggle('is-scrolled', y > 24);
      // Hide while reading down, reveal on any scroll up.
      if (y > 480 && y > lastY + 4) nav.classList.add('is-hidden');
      else if (y < lastY - 4 || y <= 480) nav.classList.remove('is-hidden');
      lastY = y;
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
  }
  document.addEventListener('astro:page-load', bindNav);
</script>
