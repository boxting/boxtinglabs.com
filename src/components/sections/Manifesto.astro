---
import type { ui } from '@/i18n/ui';

interface Props {
  t: typeof ui.es.manifesto;
}

const { t } = Astro.props;

const BODY =
  'M67 .06C72.5-.24 77.8.6 83 2.56C98 10.89 113 19.22 128 27.56C135.7 31.6 140.9 37.77 143.5 46.06C144.2 68.06 144.2 90.06 143.5 112.06C141.3 119.63 136.8 125.46 130 129.56C113.1 139.16 96.1 148.49 79 157.56C72.4 158.64 66.1 157.97 60 155.56C43.5 146.48 27.2 137.14 11 127.56C5.4 122.97 1.9 117.13.5 110.06C-.17 89.06-.17 68.06.5 47.06C3.8 38.09 9.6 31.25 18 26.56C34.1 17.16 50.5 8.32 67 .06Z';
const TOP =
  'M66 26.06C70 25.89 74 26.06 78 26.56C89.7 32.72 101 39.39 112 46.56C100.1 54.02 87.7 60.68 75 66.56C72.7 67.22 70.3 67.22 68 66.56C55.8 59.98 43.8 53.14 32 46.06C43.4 39.36 54.7 32.7 66 26.06Z';
const LEFT =
  'M22 66.06C32.3 71.88 42.6 77.71 53 83.56C56.2 85.39 58.7 87.89 60.5 91.06C62.1 104.32 62.4 117.66 61.5 131.06C51.2 124.84 40.7 119.01 30 113.56C27.3 111.96 25.1 109.8 23.5 107.06C22.1 93.46 21.6 79.8 22 66.06Z';
---

<!--
  Left column pins while the principles scroll past on the right.
  The cube builds in step with them (see manifestoScroll in src/scripts/fx.ts):
  01 draws the outline, 02 drops the lid in, 03 folds the side facet, then the mark fills.
-->
<section id="studio" class="manifesto" data-track-section="manifesto" data-manifesto>
  <div class="ambient manifesto-glow" aria-hidden="true"></div>

  <div class="page relative">
    <div class="manifesto-grid">
      <div class="manifesto-aside">
        <p class="eyebrow" data-scramble>{t.eyebrow}</p>
        <h2 class="section-title mt-4" data-split>{t.heading}</h2>

        <svg class="manifesto-cube" viewBox="-28 -28 200 215" fill="none" aria-hidden="true">
          <!-- construction guides, aligned to the mark's centre line and lid -->
          <g class="mc-guides" stroke="rgba(248,243,235,0.12)" stroke-dasharray="3 5">
            <path d="M72 -26 V 186"></path>
            <path d="M-26 46.5 H 170"></path>
            <path d="M-26 111 H 170"></path>
          </g>
          <path class="mc-fill" d={BODY} fill="#FE5D1C" opacity="0"></path>
          <path class="mc-top-fill" d={TOP} fill="#F8F3EB" opacity="0"></path>
          <path class="mc-left-fill" d={LEFT} fill="#F8F3EB" opacity="0"></path>
          <path class="mc-outline" d={BODY} stroke="rgba(248,243,235,0.55)" stroke-width="1.2"></path>
          <path class="mc-top" d={TOP} stroke="#FE5D1C" stroke-width="1.4"></path>
          <path class="mc-left" d={LEFT} stroke="#FE5D1C" stroke-width="1.4"></path>
        </svg>

        <ol class="manifesto-steps mono" aria-hidden="true">
          {t.principles.map((p) => <li data-step>{p.n}</li>)}
        </ol>
      </div>

      <div class="manifesto-main">
        <p class="manifesto-body reveal">{t.body}</p>

        <ol class="principles">
          {t.principles.map((p) => (
            <li class="principle" data-principle>
              <span class="principle-bar" aria-hidden="true"></span>
              <span class="principle-n mono">{p.n}</span>
              <h3 class="principle-title">{p.title}</h3>
              <p class="principle-body">{p.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto {
    position: relative;
    padding: clamp(96px, 14vh, 160px) 0 clamp(64px, 10vh, 120px);
    background: #08090b;
  }
  .manifesto-glow {
    left: -220px;
    top: -180px;
    width: 680px;
    height: 600px;
    background: radial-gradient(closest-side, rgba(254, 93, 28, 0.12), rgba(254, 93, 28, 0));
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
  }

  .manifesto-aside {
    position: sticky;
    top: 112px;
    align-self: start;
  }
  .manifesto-cube {
    display: block;
    width: clamp(200px, 19vw, 280px);
    margin-top: clamp(28px, 5vh, 56px);
    overflow: visible;
  }
  .manifesto-cube path {
    transform-box: fill-box;
    transform-origin: center;
  }

  .manifesto-steps {
    list-style: none;
    display: flex;
    gap: 18px;
    margin: 28px 0 0;
    padding: 0;
    font-size: 12px;
    color: rgba(248, 243, 235, 0.25);
  }
  .manifesto-steps li {
    position: relative;
    padding-top: 10px;
    transition: color 300ms ease;
  }
  .manifesto-steps li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
  }
  .manifesto-steps li.is-on {
    color: #fe5d1c;
  }

  .manifesto-body {
    margin: 0;
    max-width: 56ch;
    padding-top: clamp(28px, 4vh, 44px);
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.62;
    color: rgba(248, 243, 235, 0.6);
  }

  .principles {
    list-style: none;
    margin: clamp(56px, 10vh, 120px) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .principle {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    column-gap: 16px;
    padding: clamp(40px, 9vh, 88px) 0;
    border-top: 1px solid rgba(248, 243, 235, 0.1);
    will-change: transform, opacity;
  }
  .principle:last-child {
    border-bottom: 1px solid rgba(248, 243, 235, 0.1);
  }
  .principle-bar {
    position: absolute;
    left: 0;
    top: -1px;
    width: 100%;
    height: 1px;
    background: #fe5d1c;
    transform: scaleX(0);
    transform-origin: left;
  }
  .principle-n {
    grid-row: span 2;
    padding-top: 10px;
    font-size: 13px;
    color: #fe5d1c;
  }
  .principle-title {
    margin: 0;
    font-weight: 600;
    font-size: clamp(28px, 2.8vw, 40px);
    letter-spacing: -0.03em;
    color: #f8f3eb;
  }
  .principle-body {
    margin: 12px 0 0;
    max-width: 46ch;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: rgba(248, 243, 235, 0.55);
  }

  @media (max-width: 860px) {
    .manifesto-grid { grid-template-columns: minmax(0, 1fr); }
    .manifesto-aside { position: static; }
    .manifesto-cube, .manifesto-steps { display: none; }
    .manifesto-body { padding-top: 0; }
    .principles { margin-top: 48px; }
    .principle { padding: 32px 0; grid-template-columns: 40px minmax(0, 1fr); }
  }
</style>

<noscript>
  <style>
    .manifesto-cube .mc-fill, .manifesto-cube .mc-top-fill, .manifesto-cube .mc-left-fill { opacity: 1; }
  </style>
</noscript>
