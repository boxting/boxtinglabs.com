---
import type { ui } from '@/i18n/ui';

interface Props {
  lang: 'en' | 'es';
  t: typeof ui.es.footer;
  nav: typeof ui.es.nav;
}

const { t, nav } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer" data-track-section="footer">
  <div class="page">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-lockup">
          <img src="/svg/brand/cube-assemble.svg" alt="" width="36" height="40" class="footer-cube" loading="lazy" />
          <span class="footer-word">boxting <span>labs</span></span>
        </div>
        <p class="footer-tagline">{t.tagline}</p>
      </div>

      <div>
        <p class="footer-label mono">{t.columns.site}</p>
        <ul class="footer-list">
          <li><a href="#studio" class="footer-link">{nav.manifesto}</a></li>
          <li><a href="#capabilities" class="footer-link">{nav.capabilities}</a></li>
          <li><a href="#work" class="footer-link">{nav.work}</a></li>
        </ul>
      </div>

      <div>
        <p class="footer-label mono">{t.columns.studio}</p>
        <ul class="footer-list footer-facts">
          {t.studioFacts.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <div>
        <p class="footer-label mono">{t.columns.contact}</p>
        <a href="mailto:hello@boxtinglabs.com" class="footer-link mono footer-email" data-track-cta="footer-email">hello@boxtinglabs.com</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="mono">© {year} {t.rights}</span>
      <span class="mono">{t.practice}</span>
      <a href="#top" class="mono footer-top" data-track-cta="footer-back-to-top">
        {t.backToTop}
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 12 V2 M2.5 6.5 L7 2 L11.5 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Oversized wordmark, sliced by the page edge -->
  <div class="footer-giant" aria-hidden="true" data-parallax-y="30">boxting</div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-top: clamp(64px, 9vh, 96px);
    background: #08090b;
    border-top: 1px solid rgba(248, 243, 235, 0.08);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(248, 243, 235, 0.08);
  }
  .footer-lockup {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer-cube {
    width: 36px;
    height: 40px;
  }
  .footer-word {
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: #f8f3eb;
  }
  .footer-word span { color: #fe5d1c; }
  .footer-tagline {
    margin: 18px 0 0;
    max-width: 34ch;
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(248, 243, 235, 0.48);
  }
  .footer-label {
    margin: 0 0 14px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(248, 243, 235, 0.35);
  }
  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 14px;
  }
  .footer-facts { color: rgba(248, 243, 235, 0.55); }
  .footer-link {
    color: rgba(248, 243, 235, 0.6);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .footer-link:hover { color: #f8f3eb; }
  .footer-email {
    font-size: 13px;
    word-break: break-all;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 24px 0;
    font-size: 12px;
    color: rgba(248, 243, 235, 0.32);
  }
  .footer-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: rgba(248, 243, 235, 0.5);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .footer-top:hover { color: #fe5d1c; }

  .footer-giant {
    position: relative;
    margin-top: 8px;
    margin-bottom: -0.22em;
    text-align: center;
    font-weight: 700;
    font-size: clamp(96px, 23vw, 360px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(248, 243, 235, 0.14);
    background: linear-gradient(180deg, rgba(254, 93, 28, 0.35), rgba(254, 93, 28, 0) 70%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-brand { grid-column: 1 / -1; }
  }
</style>
