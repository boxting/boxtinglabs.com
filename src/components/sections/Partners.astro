---
import { Image } from 'astro:assets';
import ava from '@assets/images/partners/ava.png';
import jalhuca from '@assets/images/partners/jalhuca.png';
import newtransport from '@assets/images/partners/newtransport.png';
import type { ui } from '@/i18n/ui';

interface Props {
  t: typeof ui.es.partners;
}

const { t } = Astro.props;

const partners = {
  ava: { src: ava, fit: 'cover', url: 'https://ava.pe/' },
  jalhuca: { src: jalhuca, fit: 'cover', url: 'https://jalhuca.com/es/' },
  newtransport: { src: newtransport, fit: 'contain', url: 'https://www.newtransport.net/' },
} as const;
---

<section id="partners" class="partners" aria-labelledby="partners-eyebrow" data-track-section="partners">
  <div class="page">
    <div class="partners-head">
      <p id="partners-eyebrow" class="eyebrow" data-scramble>{t.eyebrow}</p>
      <p class="mono partners-note reveal">{t.note}</p>
    </div>

    <ul class="partners-row" data-rise="120">
      {t.items.map((p) => {
        const logo = partners[p.id as keyof typeof partners];
        return (
          <li>
            <a
              href={logo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="partner"
              data-track-cta={`partner-${p.id}`}
            >
              <span class="partner-logo">
                <Image src={logo.src} alt="" widths={[64, 128]} sizes="52px" class={`partner-img ${logo.fit}`} loading="lazy" />
              </span>
              <span class="partner-text">
                <span class="partner-name">{p.name}</span>
                <span class="partner-built">{p.built}</span>
                <span class="partner-meta mono">
                  {p.industry}<span class="partner-dot" aria-hidden="true">·</span>{p.year}
                </span>
              </span>
              <span class="partner-go" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M3.5 10.5 L10.5 3.5 M10.5 3.5 H4.5 M10.5 3.5 V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="sr-only">{t.cta}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .partners {
    position: relative;
    padding: clamp(56px, 8vh, 88px) 0;
    border-top: 1px solid rgba(248, 243, 235, 0.08);
    border-bottom: 1px solid rgba(248, 243, 235, 0.08);
    background: linear-gradient(180deg, #08090b, #0b0c0f 50%, #08090b);
  }
  .partners-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 28px;
  }
  .partners-note {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(248, 243, 235, 0.35);
  }

  .partners-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(248, 243, 235, 0.1);
    border-bottom: 1px solid rgba(248, 243, 235, 0.1);
  }
  .partners-row > li + li {
    border-left: 1px solid rgba(248, 243, 235, 0.1);
  }

  .partner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    height: 100%;
    padding: 32px clamp(20px, 2.4vw, 36px);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: background 260ms ease;
  }
  /* Orange wash that rises from the bottom edge on hover */
  .partner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 120%, rgba(254, 93, 28, 0.14), transparent 70%);
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }
  .partner::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: #fe5d1c;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .partner:hover::before,
  .partner:focus-visible::before { opacity: 1; }
  .partner:hover::after,
  .partner:focus-visible::after { transform: scaleX(1); }

  .partner-logo {
    position: relative;
    display: inline-flex;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 14px;
    overflow: hidden;
    background: #fffdf9;
    box-shadow: 0 0 0 1px rgba(248, 243, 235, 0.1), 0 12px 30px -12px rgba(0, 0, 0, 0.7);
    transition: transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .partner:hover .partner-logo { transform: translateY(-3px) rotate(-4deg); }
  .partner-img { width: 100%; height: 100%; }
  .partner-img.cover { object-fit: cover; }
  .partner-img.contain { object-fit: contain; padding: 5px; }

  .partner-text {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .partner-name {
    font-weight: 700;
    font-size: clamp(20px, 1.9vw, 26px);
    letter-spacing: -0.025em;
    color: rgba(248, 243, 235, 0.82);
    transition: color 200ms ease;
  }
  .partner:hover .partner-name { color: #f8f3eb; }
  .partner-built {
    font-size: 14px;
    color: rgba(248, 243, 235, 0.6);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .partner-meta {
    display: flex;
    gap: 8px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(248, 243, 235, 0.42);
  }
  .partner-dot { color: rgba(254, 93, 28, 0.7); }

  .partner-go {
    position: relative;
    margin-left: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid rgba(248, 243, 235, 0.14);
    color: rgba(248, 243, 235, 0.5);
    transition: background 220ms ease, border-color 220ms ease, color 220ms ease, transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .partner:hover .partner-go {
    background: #fe5d1c;
    border-color: #fe5d1c;
    color: #0a0b0e;
    transform: translate(2px, -2px);
  }

  @media (max-width: 860px) {
    .partners-row { grid-template-columns: minmax(0, 1fr); }
    .partners-row > li + li {
      border-left: 0;
      border-top: 1px solid rgba(248, 243, 235, 0.1);
    }
    .partner { padding: 24px 4px; }
  }
</style>
