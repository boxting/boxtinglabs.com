---
import { Image } from 'astro:assets';
import ava from '@assets/images/partners/ava.png';
import jalhuca from '@assets/images/partners/jalhuca.png';
import newtransport from '@assets/images/partners/newtransport.png';
import type { ui } from '@/i18n/ui';

interface Props {
  t: typeof ui.es.partners;
}

const { t } = Astro.props;

const partners = [
  { name: 'Ava Cash', src: ava, fit: 'cover' },
  { name: 'Jalhuca', src: jalhuca, fit: 'cover' },
  { name: 'New Transport', src: newtransport, fit: 'contain' },
];

// Each half of the track must be wider than the viewport for a seamless loop.
const half = [...partners, ...partners, ...partners];
---

<section id="partners" class="partners" aria-labelledby="partners-eyebrow" data-track-section="partners">
  <div class="page">
    <div class="partners-head">
      <p id="partners-eyebrow" class="eyebrow" data-scramble>{t.eyebrow}</p>
      <p class="mono partners-note reveal">{t.note}</p>
    </div>
  </div>

  <div class="marquee fade-x">
    <ul class="marquee-track partners-track">
      {[...half, ...half].map((p, i) => (
        <li class="partner" aria-hidden={i >= partners.length ? 'true' : undefined}>
          <span class="partner-logo">
            <Image src={p.src} alt="" widths={[64, 128]} sizes="44px" class={`partner-img ${p.fit}`} loading="lazy" />
          </span>
          <span class="partner-name">{p.name}</span>
          <svg class="partner-sep" viewBox="0 0 144 159" aria-hidden="true">
            <path d="M67 .06C72.5-.24 77.8.6 83 2.56C98 10.89 113 19.22 128 27.56C135.7 31.6 140.9 37.77 143.5 46.06C144.2 68.06 144.2 90.06 143.5 112.06C141.3 119.63 136.8 125.46 130 129.56C113.1 139.16 96.1 148.49 79 157.56C72.4 158.64 66.1 157.97 60 155.56C43.5 146.48 27.2 137.14 11 127.56C5.4 122.97 1.9 117.13.5 110.06C-.17 89.06-.17 68.06.5 47.06C3.8 38.09 9.6 31.25 18 26.56C34.1 17.16 50.5 8.32 67 .06Z" fill="rgba(248,243,235,0.14)"></path>
          </svg>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 8vh, 88px) 0;
    border-top: 1px solid rgba(248, 243, 235, 0.08);
    border-bottom: 1px solid rgba(248, 243, 235, 0.08);
    background: linear-gradient(180deg, #08090b, #0b0c0f 50%, #08090b);
  }
  .partners-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 36px;
  }
  .partners-note {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(248, 243, 235, 0.35);
  }

  .partners-track {
    display: flex;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    animation-duration: 38s;
  }
  .partner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-right: 56px;
  }
  .partner-logo {
    display: inline-flex;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    overflow: hidden;
    background: #fffdf9;
    box-shadow: 0 0 0 1px rgba(248, 243, 235, 0.1);
    flex-shrink: 0;
  }
  .partner-img {
    width: 100%;
    height: 100%;
  }
  .partner-img.cover { object-fit: cover; }
  .partner-img.contain { object-fit: contain; padding: 4px; }
  .partner-name {
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 30px);
    letter-spacing: -0.025em;
    color: rgba(248, 243, 235, 0.72);
    white-space: nowrap;
    transition: color 200ms ease;
  }
  .partner:hover .partner-name {
    color: #f8f3eb;
  }
  .partner-sep {
    width: 14px;
    height: 16px;
    margin-left: 40px;
  }
</style>
