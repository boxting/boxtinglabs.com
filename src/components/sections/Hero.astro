---
import type { ui } from '@/i18n/ui';
import AmbientField from '@/components/motion/AmbientField';
import HeroCarousel from '@/components/motion/HeroCarousel';

interface Props {
  t: typeof ui.es.hero;
  nav: typeof ui.es.nav;
  lang: 'en' | 'es';
}

const { t } = Astro.props;
const mailto = `mailto:${t.email}`;
---

<section
  id="top"
  class="hero grain"
  data-screen-label="01 Hero"
  data-hero-intro
  data-intro="pending"
  data-track-section="hero"
>
  <AmbientField client:load />

  <div class="hero-stage">
    <!-- Scene strip: what we build, rotating -->
    <div class="hero-strip" data-hero-in>
      <HeroCarousel
        client:load
        frames={t.frames}
        labels={{ region: t.carouselLabel, prev: t.prev, next: t.next, pause: t.pause, play: t.play }}
      />
    </div>

    <!-- Statement -->
    <div class="hero-copy">
      <div class="hero-emblem" aria-hidden="true">
        <svg viewBox="-6 -6 156 171" fill="none">
          <path
            class="hx-outline"
            d="M67 .06C72.5-.24 77.8.6 83 2.56C98 10.89 113 19.22 128 27.56C135.7 31.6 140.9 37.77 143.5 46.06C144.2 68.06 144.2 90.06 143.5 112.06C141.3 119.63 136.8 125.46 130 129.56C113.1 139.16 96.1 148.49 79 157.56C72.4 158.64 66.1 157.97 60 155.56C43.5 146.48 27.2 137.14 11 127.56C5.4 122.97 1.9 117.13.5 110.06C-.17 89.06-.17 68.06.5 47.06C3.8 38.09 9.6 31.25 18 26.56C34.1 17.16 50.5 8.32 67 .06Z"
            stroke="#FE5D1C"
            stroke-width="4"></path>
          <path
            class="hx-body"
            d="M67 .06C72.5-.24 77.8.6 83 2.56C98 10.89 113 19.22 128 27.56C135.7 31.6 140.9 37.77 143.5 46.06C144.2 68.06 144.2 90.06 143.5 112.06C141.3 119.63 136.8 125.46 130 129.56C113.1 139.16 96.1 148.49 79 157.56C72.4 158.64 66.1 157.97 60 155.56C43.5 146.48 27.2 137.14 11 127.56C5.4 122.97 1.9 117.13.5 110.06C-.17 89.06-.17 68.06.5 47.06C3.8 38.09 9.6 31.25 18 26.56C34.1 17.16 50.5 8.32 67 .06Z"
            fill="#FE5D1C"></path>
          <path
            class="hx-top"
            d="M66 26.06C70 25.89 74 26.06 78 26.56C89.7 32.72 101 39.39 112 46.56C100.1 54.02 87.7 60.68 75 66.56C72.7 67.22 70.3 67.22 68 66.56C55.8 59.98 43.8 53.14 32 46.06C43.4 39.36 54.7 32.7 66 26.06Z"
            fill="#F8F3EB"></path>
          <path
            class="hx-left"
            d="M22 66.06C32.3 71.88 42.6 77.71 53 83.56C56.2 85.39 58.7 87.89 60.5 91.06C62.1 104.32 62.4 117.66 61.5 131.06C51.2 124.84 40.7 119.01 30 113.56C27.3 111.96 25.1 109.8 23.5 107.06C22.1 93.46 21.6 79.8 22 66.06Z"
            fill="#F8F3EB"></path>
        </svg>
      </div>

      <p class="hero-eyebrow mono" data-hero-in>
        <span class="hero-dot" aria-hidden="true"></span>
        <span data-hero-eyebrow>{t.eyebrow}</span>
      </p>

      <h1 class="hero-title serif" data-hero-title>
        {t.titleLead}<br />
        <em>{t.titleAccent}</em>
      </h1>

      <p class="hero-lede" data-hero-in>{t.lede}</p>

      <div class="hero-ctas" data-hero-in>
        <a href={mailto} class="btn-primary" data-magnetic data-track-cta="hero-primary">
          {t.primaryCta}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7 H12 M12 7 L7.5 2.5 M12 7 L7.5 11.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href="#work" class="btn-ghost" data-track-cta="hero-secondary">{t.secondaryCta}</a>
      </div>

      <p class="hero-status mono" data-hero-in>
        <span class="hero-pulse" aria-hidden="true"></span>
        {t.status}
      </p>
    </div>
  </div>

  <a href="#studio" class="hero-scroll" aria-label={t.scrollHint} data-track-cta="hero-scroll-indicator">
    <span class="hero-scroll-line" aria-hidden="true"></span>
  </a>
</section>

<noscript>
  <style>
    .hero [data-hero-in], .hero [data-hero-title], .hero .hx-body, .hero .hx-top, .hero .hx-left { opacity: 1 !important; }
  </style>
</noscript>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    background: #08090b;
    display: flex;
    flex-direction: column;
  }

  /* Hidden until the anime.js intro takes over (see src/scripts/fx.ts). */
  .hero[data-intro='pending'] [data-hero-in],
  .hero[data-intro='pending'] [data-hero-title],
  .hero[data-intro='pending'] .hx-body,
  .hero[data-intro='pending'] .hx-top,
  .hero[data-intro='pending'] .hx-left {
    opacity: 0;
  }

  .hero-stage {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(16px, 2.6vh, 36px);
    padding: clamp(84px, 10vh, 120px) 0 clamp(48px, 7vh, 80px);
  }

  .hero-strip {
    width: 100%;
    max-width: 1680px;
    margin: 0 auto;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 24px;
  }

  .hero-emblem {
    width: 40px;
    height: 44px;
    margin-bottom: 14px;
  }
  .hero-emblem svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero-emblem path {
    transform-box: fill-box;
    transform-origin: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(248, 243, 235, 0.5);
    min-height: 16px;
  }
  .hero-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fe5d1c;
  }

  .hero-title {
    margin: 0;
    font-weight: 400;
    font-size: clamp(40px, min(5.2vw, 8.4vh), 80px);
    line-height: 1.02;
    letter-spacing: -0.012em;
    color: #fff;
    max-width: 1100px;
    text-wrap: balance;
  }
  .hero-title em {
    color: #fe5d1c;
    font-style: italic;
  }

  .hero-lede {
    margin: 18px 0 0;
    max-width: 58ch;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.62;
    color: rgba(248, 243, 235, 0.58);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 26px;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(248, 243, 235, 0.4);
  }
  .hero-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4fa98a;
    box-shadow: 0 0 0 0 rgba(79, 169, 138, 0.6);
    animation: hero-pulse 2.4s ease-out infinite;
  }
  @keyframes hero-pulse {
    0% { box-shadow: 0 0 0 0 rgba(79, 169, 138, 0.6); }
    70% { box-shadow: 0 0 0 9px rgba(79, 169, 138, 0); }
    100% { box-shadow: 0 0 0 0 rgba(79, 169, 138, 0); }
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 3;
    width: 44px;
    height: 56px;
    margin-left: -22px;
    display: flex;
    justify-content: center;
  }
  .hero-scroll-line {
    position: relative;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: rgba(248, 243, 235, 0.12);
  }
  .hero-scroll-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -50%;
    width: 1px;
    height: 50%;
    background: linear-gradient(transparent, #fe5d1c);
    animation: hero-scroll 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes hero-scroll {
    to { top: 100%; }
  }

  /* Phones: statement first, the strip follows. */
  @media (max-width: 720px) {
    .hero-stage {
      justify-content: flex-start;
      padding-top: 104px;
    }
    .hero-copy { order: -1; }
    .hero-eyebrow { max-width: 30ch; line-height: 1.8; }
    .hero-dot { display: none; }
    .hero-scroll { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pulse, .hero-scroll-line::after { animation: none; }
  }
</style>
