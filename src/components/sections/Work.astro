---
import { Image } from 'astro:assets';
import ava1 from '@assets/images/ava/AVA_iPhone_Image_1.png';
import ava2 from '@assets/images/ava/AVA_iPhone_Image_2.png';
import ava3 from '@assets/images/ava/AVA_iPhone_Image_3.png';
import ava4 from '@assets/images/ava/AVA_iPhone_Image_4.png';
import type { ui } from '@/i18n/ui';
import SpotlightCard from '@/components/motion/SpotlightCard';

interface Props {
  t: typeof ui.es.work;
}

const { t } = Astro.props;
// Fanned phones: each drifts at its own rate for depth.
const avaShots = [
  { src: ava1, drift: 36, offset: 0 },
  { src: ava2, drift: 70, offset: 40 },
  { src: ava3, drift: 24, offset: 12 },
  { src: ava4, drift: 56, offset: 52 },
];

const accentMap = {
  plum: { rgb: '199,125,188', label: '#C77DBC', tint: 'rgba(110,47,102,0.10)' },
  sky: { rgb: '125,163,255', label: '#7DA3FF', tint: 'rgba(43,92,230,0.09)' },
  orange: { rgb: '254,93,28', label: '#FF8D5C', tint: 'rgba(254,93,28,0.08)' },
} as const;
---

<section id="work" class="work" data-track-section="work">
  <div class="page">
    <div class="work-head">
      <div>
        <p class="eyebrow" data-scramble>{t.eyebrow}</p>
        <h2 class="section-title mt-4" data-split>{t.heading}</h2>
      </div>
      <p class="mono work-status reveal"><span class="work-live" aria-hidden="true"></span>{t.statusBadge}</p>
    </div>

    <!-- Featured: Ava Cash -->
    <article id="case-ava" class="featured reveal">
      <div class="featured-gallery">
        <div class="ambient featured-glow" aria-hidden="true"></div>
        <div class="featured-meta">
          <span class="mono" style="color:#FF8D5C;">{t.featured.client}</span>
          <span class="mono text-cream/35">{t.featured.year}</span>
        </div>
        <div class="phones">
          {avaShots.map((shot, i) => (
            <div class="phone" style={`margin-top:${shot.offset}px`} data-parallax-y={shot.drift}>
              <Image
                src={shot.src}
                alt={`Ava Cash · ${i + 1}`}
                widths={[220, 440]}
                sizes="(max-width: 760px) 40vw, 200px"
                class="phone-img"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
          ))}
        </div>
      </div>

      <div class="featured-copy">
        <h3 class="featured-title">{t.featured.title}</h3>
        <p class="featured-body">{t.featured.outcome}</p>
        <dl class="meta">
          <div>
            <dt class="mono">{t.metaLabels.industry}</dt>
            <dd>{t.featured.industry}</dd>
          </div>
          <div>
            <dt class="mono">{t.metaLabels.role}</dt>
            <dd>{t.featured.role}</dd>
          </div>
          <div class="meta-stack">
            <dt class="mono">Stack</dt>
            <dd>
              {t.featured.techStack.map((tech, i) => (
                <span class={i === 0 ? 'chip chip-accent' : 'chip'}>{tech}</span>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </article>

    <!-- Jalhuca + New Transport -->
    <ul class="projects" data-rise="120">
      {t.projects.map((p) => {
        const accent = accentMap[p.accent as keyof typeof accentMap] ?? accentMap.orange;
        return (
          <li>
            <SpotlightCard client:visible rgb={accent.rgb} tint={accent.tint} tilt={3}>
              <article id={`case-${p.title.toLowerCase().replace(/\s+/g, '')}`} class="project">
                <div class="project-meta">
                  <span class="mono" style={`color:${accent.label}`}>{p.client}</span>
                  <span class="mono text-cream/35">{p.year}</span>
                </div>
                <h3 class="project-title">{p.title}</h3>
                <p class="project-body">{p.outcome}</p>
                <dl class="meta">
                  <div>
                    <dt class="mono">{t.metaLabels.industry}</dt>
                    <dd>{p.industry}</dd>
                  </div>
                  <div>
                    <dt class="mono">{t.metaLabels.role}</dt>
                    <dd>{p.role}</dd>
                  </div>
                  <div class="meta-stack">
                    <dt class="mono">Stack</dt>
                    <dd>
                      {p.techStack.map((tech) => (
                        <span class="chip">{tech}</span>
                      ))}
                    </dd>
                  </div>
                </dl>
              </article>
            </SpotlightCard>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .work {
    position: relative;
    padding: clamp(96px, 14vh, 160px) 0;
    background: #08090b;
  }
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(40px, 6vh, 56px);
  }
  .work-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 12px;
    color: rgba(248, 243, 235, 0.45);
  }
  .work-live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fe5d1c;
    animation: live 2s ease-in-out infinite;
  }
  @keyframes live {
    50% { opacity: 0.3; }
  }

  .featured,
  .project {
    scroll-margin-top: 96px;
  }
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    overflow: hidden;
    border-radius: 22px;
    border: 1px solid rgba(248, 243, 235, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }
  .featured-gallery {
    position: relative;
    overflow: hidden;
    padding: 28px;
    background: #0c0d10;
    min-height: 460px;
  }
  .featured-glow {
    left: 10%;
    top: 20%;
    width: 520px;
    height: 420px;
    background: radial-gradient(closest-side, rgba(254, 93, 28, 0.2), rgba(254, 93, 28, 0));
  }
  .featured-meta {
    position: relative;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    margin-bottom: 24px;
  }
  .phones {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 18px);
    align-items: start;
  }
  .phone {
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 9 / 19.5;
    background: #15161a;
    box-shadow: 0 0 0 1px rgba(248, 243, 235, 0.1), 0 30px 60px -24px rgba(0, 0, 0, 0.8);
    will-change: transform;
  }
  .phone-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .featured-copy {
    padding: clamp(28px, 3vw, 40px);
    display: flex;
    flex-direction: column;
  }
  .featured-title {
    margin: 0;
    font-weight: 700;
    font-size: clamp(30px, 3vw, 40px);
    letter-spacing: -0.03em;
    color: #f8f3eb;
  }
  .featured-body {
    margin: 16px 0 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: rgba(248, 243, 235, 0.58);
  }

  .meta {
    margin: auto 0 0;
    padding-top: 24px;
    border-top: 1px solid rgba(248, 243, 235, 0.1);
    display: grid;
    gap: 10px;
  }
  .featured-copy .meta {
    margin-top: 32px;
  }
  .meta > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }
  .meta dt {
    font-size: 11px;
    color: rgba(248, 243, 235, 0.4);
    flex-shrink: 0;
  }
  .meta dd {
    margin: 0;
    font-size: 13.5px;
    text-align: right;
    color: #f8f3eb;
  }
  .meta-stack {
    margin-top: 6px;
  }
  .meta-stack dd {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }

  .projects {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .project {
    padding: clamp(24px, 2.6vw, 32px);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
  }
  .project-title {
    margin: 16px 0 0;
    font-weight: 600;
    font-size: clamp(24px, 2.2vw, 30px);
    letter-spacing: -0.025em;
    color: #f8f3eb;
  }
  .project-body {
    margin: 14px 0 28px;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(248, 243, 235, 0.52);
  }

  @media (max-width: 960px) {
    .featured { grid-template-columns: minmax(0, 1fr); }
    .featured-gallery { min-height: 0; }
  }
  @media (max-width: 760px) {
    .projects { grid-template-columns: minmax(0, 1fr); }
    .phones { grid-template-columns: repeat(4, minmax(120px, 1fr)); overflow-x: auto; padding-bottom: 8px; }
    .phone { margin-top: 0 !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-live { animation: none; }
  }
</style>
