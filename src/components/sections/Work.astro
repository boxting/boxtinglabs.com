---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ui } from '@/i18n/ui';

interface Props {
  t: typeof ui.es.work;
}

const { t } = Astro.props;

/**
 * Visual per project. With `shots`, the card shows the real screenshots in the given frame
 * (`phone`: a fanned row with parallax, `browser`: the first shot in a browser window).
 * With no shots it falls back to the illustrated scene at /svg/work/<id>.svg.
 * To swap a scene for real app images, import them above and list them here —
 * e.g. Ava's store screenshots live in src/assets/images/ava/AVA_iPhone_Image_{1..4}.png.
 */
const visuals: Record<string, { frame: 'phone' | 'browser'; shots: ImageMetadata[] }> = {
  ava: { frame: 'phone', shots: [] },
  jalhuca: { frame: 'phone', shots: [] },
  newtransport: { frame: 'browser', shots: [] },
};

const tones = {
  orange: { hex: '#FF8D5C', rgb: '254,93,28' },
  mint: { hex: '#7CD6B4', rgb: '79,169,138' },
  sky: { hex: '#7DA3FF', rgb: '43,92,230' },
} as const;

// Fanned phones: each drifts at its own rate for depth.
const phoneRhythm = [
  { drift: 36, offset: 0 },
  { drift: 70, offset: 40 },
  { drift: 24, offset: 12 },
  { drift: 56, offset: 52 },
];
const total = String(t.items.length).padStart(2, '0');
---

<section id="work" class="work" data-track-section="work">
  <div class="page">
    <div class="work-head">
      <div>
        <p class="eyebrow" data-scramble>{t.eyebrow}</p>
        <h2 class="section-title mt-4" data-split>{t.heading}</h2>
      </div>
      <p class="mono work-status reveal"><span class="work-live" aria-hidden="true"></span>{t.statusBadge}</p>
    </div>

    <!-- Stacking cards: each case pins near the top and the next slides over it (fx.ts: workStack) -->
    <ol class="stack" data-work-stack>
      {t.items.map((p, i) => {
        const tone = tones[p.accent as keyof typeof tones] ?? tones.orange;
        const visual = visuals[p.id] ?? { frame: 'phone', shots: [] };
        return (
          <li class="stack-item" data-stack-item style={`--i:${i}`}>
            <article class="case" style={`--tone:${tone.hex};--tone-rgb:${tone.rgb}`}>
              <div class="case-visual">
                <div class="ambient case-glow" aria-hidden="true"></div>
                {visual.shots.length > 0 && visual.frame === 'phone' && (
                  <div class="phones">
                    {visual.shots.map((shot, s) => (
                      <div
                        class="phone"
                        style={`margin-top:${phoneRhythm[s % 4].offset}px`}
                        data-parallax-y={phoneRhythm[s % 4].drift}
                      >
                        <Image
                          src={shot}
                          alt={`${p.title} · ${s + 1}`}
                          widths={[220, 440]}
                          sizes="(max-width: 760px) 40vw, 200px"
                          class="phone-img"
                          loading="lazy"
                        />
                      </div>
                    ))}
                  </div>
                )}
                {visual.shots.length > 0 && visual.frame === 'browser' && (
                  <div class="browser">
                    <div class="browser-bar" aria-hidden="true"><span></span><span></span><span></span></div>
                    <Image src={visual.shots[0]} alt={p.title} widths={[640, 1280]} sizes="(max-width: 960px) 90vw, 640px" class="browser-img" loading="lazy" />
                  </div>
                )}
                {visual.shots.length === 0 && (
                  <img src={`/svg/work/${p.id}.svg`} alt="" width="640" height="480" class="case-scene" loading="lazy" />
                )}
              </div>

              <div class="case-copy">
                <div class="case-top mono">
                  <span style="color: var(--tone)">{p.client}</span>
                  <span>{String(i + 1).padStart(2, '0')} / {total} · {p.year}</span>
                </div>
                <p class="case-about mono">{p.about}</p>
                <h3 class="case-title">{p.title}</h3>
                <p class="case-body">{p.outcome}</p>

                <ul class="case-highlights">
                  {p.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>

                <dl class="meta">
                  <div>
                    <dt class="mono">{t.metaLabels.role}</dt>
                    <dd>{p.role}</dd>
                  </div>
                  <div class="meta-stack">
                    <dt class="mono">{t.metaLabels.stack}</dt>
                    <dd>
                      {p.techStack.map((tech, k) => (
                        <span class={k === 0 ? 'chip chip-tone' : 'chip'}>{tech}</span>
                      ))}
                    </dd>
                  </div>
                </dl>

                <a href={p.url} target="_blank" rel="noopener noreferrer" class="case-link" data-track-cta={`work-${p.id}-site`}>
                  {t.visit}
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3.5 10.5 L10.5 3.5 M10.5 3.5 H4.5 M10.5 3.5 V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <span class="sr-only">{t.newTab}</span>
                </a>
              </div>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .work {
    position: relative;
    padding: clamp(96px, 14vh, 160px) 0;
    background: #08090b;
  }
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(40px, 6vh, 56px);
  }
  .work-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 12px;
    color: rgba(248, 243, 235, 0.45);
  }
  .work-live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fe5d1c;
    animation: live 2s ease-in-out infinite;
  }
  @keyframes live {
    50% { opacity: 0.3; }
  }

  /* ---- stack ---- */
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stack-item {
    position: sticky;
    /* each card pins a little lower than the one before, so the deck edges show */
    top: calc(84px + var(--i) * 18px);
  }
  .stack-item + .stack-item {
    margin-top: 14vh;
  }

  .case {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    /* equal heights keep the deck edges even; capped so a pinned card fits under the nav */
    min-height: min(700px, calc(100vh - 150px));
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgba(248, 243, 235, 0.1);
    /* opaque, so a card fully covers the one it slides over */
    background:
      radial-gradient(90% 70% at 0% 0%, rgba(var(--tone-rgb), 0.07), transparent 60%),
      #0e0f12;
    box-shadow: 0 -30px 60px -30px rgba(0, 0, 0, 0.9);
    transform-origin: center top;
    will-change: transform, filter;
    transition: border-color 300ms ease;
  }
  .case:hover {
    border-color: rgba(var(--tone-rgb), 0.4);
  }

  .case-visual {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 28px;
    background: #0b0c0f;
    border-right: 1px solid rgba(248, 243, 235, 0.06);
  }
  .case-glow {
    left: 15%;
    top: 20%;
    width: 70%;
    height: 60%;
    background: radial-gradient(closest-side, rgba(var(--tone-rgb), 0.22), rgba(var(--tone-rgb), 0));
  }
  .case-scene {
    position: relative;
    width: 100%;
    max-width: 620px;
    height: auto;
  }

  .phones {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 18px);
    align-items: start;
  }
  .phone {
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 9 / 19.5;
    background: #15161a;
    box-shadow: 0 0 0 1px rgba(248, 243, 235, 0.1), 0 30px 60px -24px rgba(0, 0, 0, 0.8);
    will-change: transform;
  }
  .phone-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .browser {
    position: relative;
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(248, 243, 235, 0.14);
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.8);
  }
  .browser-bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    background: #15161a;
  }
  .browser-bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(248, 243, 235, 0.2);
  }
  .browser-bar span:first-child { background: #fe5d1c; }
  .browser-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .case-copy {
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 3vw, 44px);
  }
  .case-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 11px;
    color: rgba(248, 243, 235, 0.35);
  }
  .case-about {
    margin: 22px 0 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(248, 243, 235, 0.45);
  }
  .case-title {
    margin: 8px 0 0;
    font-weight: 700;
    font-size: clamp(30px, 3vw, 42px);
    letter-spacing: -0.03em;
    color: #f8f3eb;
  }
  .case-body {
    margin: 14px 0 0;
    font-size: 15.5px;
    line-height: 1.62;
    color: rgba(248, 243, 235, 0.6);
  }
  .case-highlights {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .case-highlights li {
    position: relative;
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(248, 243, 235, 0.75);
  }
  .case-highlights li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 7px;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--tone);
    transform: rotate(45deg);
  }

  .meta {
    margin: auto 0 0;
    padding-top: 22px;
    display: grid;
    gap: 10px;
  }
  .case-highlights + .meta {
    margin-top: 26px;
    border-top: 1px solid rgba(248, 243, 235, 0.1);
  }
  .meta > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }
  .meta dt {
    font-size: 11px;
    color: rgba(248, 243, 235, 0.4);
    flex-shrink: 0;
  }
  .meta dd {
    margin: 0;
    font-size: 13.5px;
    text-align: right;
    color: #f8f3eb;
  }
  .meta-stack { margin-top: 4px; }
  .meta-stack dd {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }
  .chip-tone {
    background: rgba(var(--tone-rgb), 0.16);
    color: var(--tone);
  }

  .case-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 18px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid rgba(248, 243, 235, 0.16);
    color: #f8f3eb;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  .case-link svg { transition: transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  .case-link:hover {
    background: var(--tone);
    border-color: var(--tone);
    color: #0a0b0e;
  }
  .case-link:hover svg { transform: translate(2px, -2px); }

  @media (max-width: 960px) {
    .case { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .case-visual { border-right: 0; border-bottom: 1px solid rgba(248, 243, 235, 0.06); }
  }
  /* Laptop-height windows: tighter copy so a pinned card still fits under the nav */
  @media (max-height: 900px) {
    .case-copy { padding: 26px 32px; }
    .case-about { margin-top: 16px; }
    .case-body { font-size: 14.5px; line-height: 1.55; }
    .case-highlights { margin-top: 14px; gap: 6px; }
    .case-highlights li { font-size: 13.5px; }
    .case-highlights + .meta { margin-top: 18px; padding-top: 16px; }
    .case-link { margin-top: 14px; }
  }

  /* Phones and short windows: cards scroll normally instead of pinning */
  @media (max-width: 860px), (max-height: 780px) {
    .stack-item { position: static; }
    .stack-item + .stack-item { margin-top: 24px; }
    .case { min-height: 0; }
  }
  @media (max-width: 760px) {
    .phones { grid-template-columns: repeat(4, minmax(120px, 1fr)); overflow-x: auto; padding-bottom: 8px; }
    .phone { margin-top: 0 !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-live { animation: none; }
  }
</style>
