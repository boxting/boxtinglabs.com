---
import { getImage } from 'astro:assets';
import ava1 from '@assets/images/ava/AVA_iPhone_Image_1.png';
import ava2 from '@assets/images/ava/AVA_iPhone_Image_2.png';
import ava3 from '@assets/images/ava/AVA_iPhone_Image_3.png';
import ava4 from '@assets/images/ava/AVA_iPhone_Image_4.png';
import type { ui } from '@/i18n/ui';
import StickyWorkShowcase from '@/components/ui/StickyWorkShowcase';

interface Props {
  t: typeof ui.es.work;
}

const { t } = Astro.props;
const avaShots = [ava1, ava2, ava3, ava4];
const avaOptimized = await Promise.all(avaShots.map((src) => getImage({ src, width: 400 })));

const projects = [
  {
    key: 'ava-cash',
    client: t.featured.client,
    title: t.featured.title,
    industry: t.featured.industry,
    role: t.featured.role,
    year: t.featured.year,
    outcome: t.featured.outcome,
    accent: 'orange' as const,
    images: avaOptimized.map((img) => img.src),
  },
  ...t.projects.map((p) => ({
    key: p.title,
    client: p.client,
    title: p.title,
    industry: p.industry,
    role: p.role,
    year: p.year,
    outcome: p.outcome,
    accent: p.accent as 'plum' | 'sky' | 'orange',
  })),
];
---

<section id="work" class="py-9 md:py-10" data-track-section="work">
  <div class="page" data-stagger="80">
    <!-- Section header -->
    <div class="grid grid-cols-12 gap-y-6 md:gap-x-6 items-end mb-8 md:mb-9">
      <div class="col-span-12 md:col-span-7">
        <p class="eyebrow reveal">{t.eyebrow}</p>
        <h2
          class="reveal mt-4 text-ink"
          style="font-size: clamp(36px, 5vw, 56px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 700;"
        >
          {t.heading}
        </h2>
      </div>
      <div class="col-span-12 md:col-span-5 md:text-right reveal">
        <p class="mono text-caption text-fog">
          <span class="text-orange">●</span> {t.statusBadge}
        </p>
      </div>
    </div>

    <StickyWorkShowcase client:visible projects={projects} metaLabels={t.metaLabels} />
  </div>
</section>
